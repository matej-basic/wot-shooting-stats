# World of Tanks API
# Required: your Wargaming application ID from https://developers.wargaming.net/applications/
WOT_API_KEY=your-wargaming-application-id

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=wot_stats
DATABASE_USER=wot_user
DATABASE_PASSWORD=wot_password

# File paths
VEHICLE_CACHE_PATH=utils/vehicles.json
MAP_CACHE_PATH=utils/maps_cache.json
TEMP_UPLOAD_DIR=/tmp

# Admin
# Bearer token for PUT/DELETE /battles/{id}; leave empty to disable both routes (generate with: openssl rand -base64 32)
ADMIN_TOKEN=change-me-to-a-long-random-string

# API docs
# Set to 1 to serve /docs, /redoc and /openapi.json; keep 0 in production
ENABLE_DOCS=0

# CORS
# Comma-separated browser origins allowed to call the API (default: the Vercel front end and localhost:3000)
CORS_ORIGINS=https://wot-shooting-stats.vercel.app,http://localhost:3000
# One extra origin appended to CORS_ORIGINS, handy as a separate Railway variable
FRONTEND_ORIGIN=
# Optional full-match regex for extra origins, e.g. Vercel previews; anchor it to your own project and team slug
CORS_ORIGIN_REGEX=
# Set to true only if the front end sends cookies or other credentials
CORS_ALLOW_CREDENTIALS=false
